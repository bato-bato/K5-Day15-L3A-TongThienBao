# ==============================================================================
# AI in Action · learning-app Environment Configuration
# ==============================================================================
# Chép file này thành .env rồi điền cấu hình của bạn:
#   - Windows:     copy .env.example .env
#   - macOS/Linux: cp .env.example .env
#
# BẢO MẬT: KHÔNG commit file .env (đã được chặn trong .gitignore ở thư mục gốc).
#          Không dán API key vào source code, slide hay ảnh chụp màn hình.
#
# LƯU Ý RUNTIME:
#   - Docker Compose (`docker compose up`) tự động đọc file `learning-app/.env`.
#   - Chạy local bằng `uvicorn` KHÔNG tự nạp `.env` (vì `requirements.txt` không có
#     `python-dotenv`); cần export biến môi trường vào shell trước khi chạy.
#   - Frontend (`learning-app/frontend`) hiện không sử dụng biến `VITE_*`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM / ChatBot & Knowledge Mapping (chat_engine.py, mapper.py)
# ------------------------------------------------------------------------------
# API key dùng chung cho Chat, Knowledge Mapper và Remote Embeddings (fallback).
# Nếu bỏ trống, hệ thống tự fallback sang chế độ extractive offline.
OPENAI_API_KEY=

# Tuỳ chọn: API key riêng cho Chat & Mapper (ghi đè OPENAI_API_KEY nếu có).
LLM_API_KEY=

# Endpoint tương thích OpenAI API (OpenAI, OpenRouter, Gemini OpenAI-compat, Ollama...).
OPENAI_BASE_URL=https://api.openai.com/v1

# Model mặc định dùng cho Knowledge Mapper và ChatBot.
LLM_MODEL=gpt-4o-mini

# Tuỳ chọn: model riêng cho ChatBot (ghi đè LLM_MODEL nếu có).
CHAT_MODEL=

# Bật/tắt gọi LLM từ xa:
#   - 1 (hoặc bỏ trống): gọi LLM khi có API key
#   - 0: ép chạy fallback extractive offline ngay cả khi đã cấu hình API key
# Lưu ý: docker-compose.yml hiện chưa forward biến này vào container backend.
USE_REMOTE_LLM=1

# HTTP timeout (giây) cho mỗi request gọi LLM trong ChatBot.
# Lưu ý: docker-compose.yml hiện chưa forward biến này vào container backend.
CHAT_LLM_TIMEOUT=25

# ------------------------------------------------------------------------------
# 2. Semantic Search & Remote Embeddings (semantic_engine.py)
# ------------------------------------------------------------------------------
# Chế độ embedding cho Semantic Search:
#   - 0: dùng local deterministic embeddings (mặc định, không tốn chi phí API)
#   - 1: gọi remote `/embeddings` endpoint
USE_REMOTE_EMBEDDINGS=0

# Tuỳ chọn: API key riêng cho Embeddings (mặc định fallback về OPENAI_API_KEY).
# Lưu ý: docker-compose.yml hiện chưa forward biến này vào container backend.
EMBEDDING_API_KEY=

# Model dùng khi USE_REMOTE_EMBEDDINGS=1.
# Lưu ý: docker-compose.yml hiện chưa forward biến này vào container backend.
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 3. SQLite Storage Paths (main.py, graph_db.py)
# ------------------------------------------------------------------------------
# Mặc định được comment để:
#   - Chạy local tự dùng đường dẫn tương đối (`backend/learning.sqlite3` và
#     `backend/kg_data/graphrag.sqlite3`).
#   - Docker Compose tự map vào volume `/data/*.sqlite3`.
# Chỉ bỏ comment khi muốn chỉ định đường dẫn SQLite tuỳ chỉnh.
# LEARNING_DB_PATH=./backend/learning.sqlite3
# GRAPH_DB_PATH=./backend/kg_data/graphrag.sqlite3
